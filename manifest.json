{
    "manifest_version": 2,
    "name": "SideAI - AI Assistant",
    "version": "2.1.0",
    "description": "A high-contrast neubrutalist AI assistant that sits on the right side of your screen.",
    "permissions": [
        "storage",
        "activeTab",
        "tabs",
        "https://api.groq.com/*",
        "<all_urls>"
    ],
    "browser_action": {
        "default_title": "Toggle SideAI",
        "default_icon": {
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png"
        }
    },
    "background": {
        "scripts": [
            "background.js"
        ],
        "persistent": true
    },
    "web_accessible_resources": [
        "icons/*",
        "content.css",
        "sidebar.html",
        "sidebar.js"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "sideai@amals.xyz",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    }
}